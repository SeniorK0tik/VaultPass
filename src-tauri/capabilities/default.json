{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения окон «Сейфа». Список намеренно короткий: интерфейсу нужны только буфер обмена, открытие внешней ссылки и управление собственными окнами.",
  "windows": ["main", "quick", "tray", "editor", "generator", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:event:default",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "log:default"
  ]
}
